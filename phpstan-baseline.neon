parameters:
	ignoreErrors:
		-
			message: '#^Method App\\Http\\Controllers\\Api\\ClaimController\:\:nextReference\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: app/Http/Controllers/Api/ClaimController.php

		-
			message: '#^Method App\\Http\\Controllers\\Api\\ClaimController\:\:submissionRules\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: app/Http/Controllers/Api/ClaimController.php

		-
			message: '#^Strict comparison using \!\=\= between string and App\\Enums\\ClaimStatus\:\:Draft will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: app/Http/Controllers/Api/ClaimController.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: app/Http/Controllers/Api/ClaimController.php

		-
			message: '#^Call to an undefined method Laravel\\Passport\\Contracts\\ScopeAuthorizable\:\:revoke\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Http/Controllers/AuthController.php

		-
			message: '#^Call to an undefined method App\\Http\\Resources\\TodoCollection\:\:currentPage\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Http/Resources/TodoCollection.php

		-
			message: '#^Call to an undefined method App\\Http\\Resources\\TodoCollection\:\:lastPage\(\)\.$#'
			identifier: method.notFound
			count: 1
