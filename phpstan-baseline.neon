			identifier: property.notFound
			count: 1
			path: app/Http/Resources/TodoResource.php

		-
			message: '#^Access to an undefined property App\\Http\\Resources\\TodoResource\:\:\$due_date\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Resources/TodoResource.php

		-
			message: '#^Access to an undefined property App\\Http\\Resources\\TodoResource\:\:\$id\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Resources/TodoResource.php

		-
			message: '#^Access to an undefined property App\\Http\\Resources\\TodoResource\:\:\$priority\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Resources/TodoResource.php

		-
			message: '#^Access to an undefined property App\\Http\\Resources\\TodoResource\:\:\$status\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Resources/TodoResource.php

		-
			message: '#^Access to an undefined property App\\Http\\Resources\\TodoResource\:\:\$title\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Resources/TodoResource.php

		-
			message: '#^Access to an undefined property App\\Http\\Resources\\TodoResource\:\:\$updated_at\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Resources/TodoResource.php

		-
			message: '#^Cannot access property \$value on string\.$#'
			identifier: property.nonObject
			count: 1
			path: app/Models/Claim.php

		-
			message: '#^Cannot call method canTransitionTo\(\) on string\.$#'
			identifier: method.nonObject
			count: 1
			path: app/Models/Claim.php

		-
			message: '#^Property App\\Models\\Claim\:\:\$status \(string\) does not accept App\\Enums\\ClaimStatus\.$#'
			identifier: assign.propertyType
			count: 1
			path: app/Models/Claim.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 2
			path: app/Models/Policy.php

		-
			message: '#^Strict comparison using \=\=\= between string and App\\Enums\\PolicyStatus\:\:Active will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: app/Models/Policy.php

		-
			message: '#^Instanceof between string and App\\Enums\\Role will always evaluate to false\.$#'
			identifier: instanceof.alwaysFalse
			count: 1
			path: app/Models/User.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 1
			path: app/Models/User.php

		-
			message: '#^Strict comparison using \=\=\= between string and App\\Enums\\Role will always evaluate to false\.$#'
