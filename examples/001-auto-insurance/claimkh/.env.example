APP_NAME=ClaimKH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=km
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=claimkh
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=claimkh_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# S3-compatible storage (Wasabi or AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=claimkh-documents
AWS_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# SMS: Vonage (primary)
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=ClaimKH

# SMS: Twilio (fallback)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@claimkh.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# OTP settings
OTP_EXPIRES_MINUTES=5
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW_SECONDS=600

# Horizon queue worker
HORIZON_PREFIX=claimkh_
