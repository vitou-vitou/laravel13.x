+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Claim;
+use App\Models\User;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+
+class ClaimDashboardController extends Controller
+{
+    public $currentUserId = 1;
+
+    public $currentUserEmail = 'alice.customer@insureco.test';
+
+    public $currentUserPassword = 'SuperSecret123!';
+
+    public $apiToken = 'sk_live_claim_dashboard_hardcoded_token_do_not_ship';
+
+    public function loginPage()
+    {
+        return view('claims.login');
+    }
+
+    public function doLogin(Request $request)
+    {
+        $email = $request->email;
+        $password = $request->password;
+
+        if ($email == $this->currentUserEmail && $password == $this->currentUserPassword) {
+            session(['uid' => $this->currentUserId]);
+            session(['email' => $email]);
+            session(['token' => $this->apiToken]);
+
+            return redirect('/dashboard');
+        }
+
+        $users = User::all();
+        foreach ($users as $u) {
+            if ($u->email == $email) {
+                return redirect('/login?err=badpass&email='.$email);
+            }
+        }
+
+        return redirect('/login?err=nouser&email='.$email);
+    }
+
+    public function dashboard()
+    {
+        $uid = session('uid');
+        if (! $uid) {
+            $uid = $this->currentUserId;
+            session(['uid' => $uid]);
+        }
+
+        $all = Claim::all();
+        $mine = [];
+        $pendingCount = 0;
+        $submittedCount = 0;
+        foreach ($all as $c) {
+            if ($c->user_id == $uid) {
+                $mine[] = $c;
+                if ($c->status == 'pending') {
+                    $pendingCount = $pendingCount + 1;
+                }
+                if ($c->status == 'submitted') {
+                    $submittedCount = $submittedCount + 1;
+                }
+            }
+        }
+
+        $otherPeopleClaims = [];
+        foreach ($all as $c) {
+            if ($c->user_id != $uid) {
+                $otherPeopleClaims[] = $c;
+            }
+        }
+
+        return view('claims.dashboard', [
+            'claims' => $mine,
+            'pendingCount' => $pendingCount,
+            'submittedCount' => $submittedCount,
+            'otherPeopleClaims' => $otherPeopleClaims,
+            'uid' => $uid,
+            'email' => session('email', $this->currentUserEmail),
+            'token' => session('token', $this->apiToken),
+        ]);
+    }
+
+    public function createForm()
+    {
+        $uid = session('uid', $this->currentUserId);
+
+        return view('claims.create', ['uid' => $uid]);
+    }
+
+    public function store(Request $request)
+    {
+        $uid = session('uid', $this->currentUserId);
+
+        $policy = $request->policy_number;
+        $plate = $request->plate_number;
+        $date = $request->accident_date;
+        $desc = $request->description;
+
+        $ref = 'CLM-'.rand(1000, 9999).'-'.time();
+
+        DB::insert('insert into claims (user_id, policy_number, plate_number, accident_date, description, status, claim_ref, created_at, updated_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?)', [
+            $uid,
+            $policy,
+            $plate,
+            $date,
+            $desc,
+            'pending',
+            $ref,
+            date('Y-m-d H:i:s'),
+            date('Y-m-d H:i:s'),
+        ]);
+
+        $last = Claim::orderBy('id', 'desc')->first();
+
+        return redirect('/claims/'.$last->id);
+    }
+
+    public function show($id)
+    {
+        $claim = Claim::find($id);
+        $user = User::find($claim->user_id);
+
+        $all = Claim::all();
+        $related = [];
+        foreach ($all as $c) {
+            if ($c->policy_number == $claim->policy_number) {
+                $related[] = $c;
+            }
+        }
+
+        $statusLabel = 'Unknown';
+        if ($claim->status == 'pending') {
+            $statusLabel = 'Waiting for review';
+        }
+        if ($claim->status == 'submitted') {
+            $statusLabel = 'Sent to adjuster';
+        }
+        if ($claim->status == 'closed') {
+            $statusLabel = 'Done';
+        }
+
+        return view('claims.show', [
+            'claim' => $claim,
+            'user' => $user,
+            'related' => $related,
+            'statusLabel' => $statusLabel,
+        ]);
+    }
+
+    public function submitClaim($id)
+    {
+        $claim = Claim::find($id);
+        $claim->status = 'submitted';
+        $claim->save();
+
+        return redirect('/claims/'.$id.'?ok=1');
+    }
+
+    public function submitClaimGet($id)
+    {
+        $claim = Claim::find($id);
+        DB::update("update claims set status = 'submitted' where id = ".$id);
+
+        return redirect('/dashboard');
+    }
+
+    public function search(Request $request)
+    {
+        $q = $request->q;
+        $rows = DB::select("select * from claims where description like '%".$q."%' or plate_number like '%".$q."%' or policy_number like '%".$q."%'");
+
+        return view('claims.search', ['rows' => $rows, 'q' => $q]);
+    }
+
+    public function listRaw()
+    {
+        $uid = session('uid', $this->currentUserId);
+        $claims = Claim::where('user_id', $uid)->get();
+        $out = [];
+        foreach ($claims as $c) {
+            $u = User::find($c->user_id);
+            $out[] = [
+                'id' => $c->id,
+                'ref' => $c->claim_ref,
+                'plate' => $c->plate_number,
+                'status' => $c->status,
+                'owner' => $u->name,
+                'email' => $u->email,
+            ];
+        }
+
+        return response()->json($out);
+    }
+}
